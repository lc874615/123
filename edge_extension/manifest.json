{
  "manifest_version": 3,
  "name": "Ozon 本地作图助手",
  "version": "0.5.1",
  "description": "连接本地工具，在你当前的 ChatGPT 标签页执行单张作图任务。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}