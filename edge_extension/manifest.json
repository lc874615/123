{
  "manifest_version": 3,
  "name": "Ozon 本地作图助手",
  "version": "0.22.0",
  "description": "连接本地工具，自动采集当前GPT任务的生成图库、图片文件及ZIP。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}